# Telegram MTProto credentials from https://my.telegram.org
API_ID=123456
API_HASH=replace_me

# Bot token from @BotFather
BOT_TOKEN=123456:replace_me

# ВАЖНО: Номер телефона для userbot (формат: +1234567890)
# Метод GetResaleStarGiftsRequest работает ТОЛЬКО с пользовательским аккаунтом, НЕ с ботом!
# Оставьте пустым, если у вас уже есть файл сессии (.session)
PHONE_NUMBER=

# Numeric ID of your forum supergroup, usually starts with -100
GROUP_ID=-1001234567890

# Seconds between scan cycles. Start conservatively; Telegram may rate-limit.
POLL_INTERVAL=60

# Session file name. Keep this private; it grants access to your Telegram account.
SESSION_NAME=tracker_session

# Optional: comma-separated numeric gift IDs to scan. Leave empty to try the catalog.
# If catalog scanning fails with your installed Telegram layer, set these manually.
GIFT_IDS=

# On first launch, mark currently visible listings as seen without publishing them.
# true = no backlog spam on first run; false = publish everything found on first scan.
SEED_EXISTING=true

# Maximum pages per gift per cycle; prevents endless scans.
MAX_PAGES_PER_GIFT=5

# Log level: INFO, DEBUG, WARNING
LOG_LEVEL=INFO

# Отслеживать неулучшенные подарки (без Stars)
# true = включить, false = только улучшенные подарки
TRACK_NON_UPGRADED=false

# Название темы для всех неулучшенных подарков
NON_UPGRADED_TOPIC_NAME=🎁 Неулучшенные подарки
PHONE_NUMBER=79003522335